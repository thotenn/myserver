package templates

import "github.com/thotenn/myserver/internal/config"

// The shell/fragment pair, isolated. Copy this when adding any panel that
// depends on an upstream call.
//
// The shell is rendered synchronously with the page and MUST NOT block on
// anything: the dashboard's first paint stays fast because no handler waits on
// docker, a ping or a remote API.

// ExampleFragmentShell — the part that ships with the page.
templ ExampleFragmentShell(svc config.Service, groupName string) {
	<div
		hx-get={ proxyURL(groupName, svc.Name, "default") }
		hx-trigger="load, every 30s [document.visibilityState === 'visible']"
		hx-swap="innerHTML"
		hx-target="this"
		class="mt-3 pt-2 border-t border-theme-100 dark:border-theme-700 min-w-0"
	>
		<span class="htmx-indicator text-xs text-theme-400">…</span>
	</div>
}

// ExampleFragment — the part the handler renders on each poll.
//
// Rules for a fragment:
//   - no outer wrapper: the shell is the wrapper and must survive the swap,
//     or its triggers stop firing;
//   - `min-w-0` on anything that holds text, so it can shrink;
//   - `pointer-events-auto` on anything clickable, because the fragment lands
//     inside the card's `pointer-events-none` content wrapper and the
//     card-wide stretched link would otherwise swallow the click;
//   - an error state that is a rendered fragment, not an HTTP error body.
templ ExampleFragment(items []DynamicListItem, lang string) {
	if len(items) == 0 {
		<div class="text-xs text-theme-400 italic">{ T(lang, "widgets.loading") }</div>
	} else {
		<div class="grid grid-cols-2 gap-2 text-[11px]">
			for _, it := range items {
				<div class="flex flex-col min-w-0">
					<span class="widget-label wrap-anywhere">{ it.Name }</span>
					<span class="widget-value wrap-anywhere">{ it.Label }</span>
				</div>
			}
		</div>
	}
}
