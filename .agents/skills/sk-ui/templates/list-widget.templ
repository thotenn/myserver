package templates

// A scrollable list inside a card. This is the ONE place the UI truncates on
// purpose: rows are uniform and the list is scannable, so per-row clipping
// keeps it readable where wrapping would turn it into a wall.
//
// `pointer-events-auto` on the <ul> is load-bearing. The list renders inside
// the card's `pointer-events-none` content wrapper, so without it every row
// link is dead — clicks go to the card-wide stretched anchor behind it.
//
// `max-h-40 overflow-y-auto` caps the card height; the container scrolls, the
// page never does.
templ ExampleList(items []DynamicListItem, lang string) {
	if len(items) == 0 {
		<div class="text-xs text-theme-400 italic">{ T(lang, "widgets.loading") }</div>
	} else {
		<ul class="divide-y divide-theme-200 dark:divide-theme-700 text-xs max-h-40 overflow-y-auto pointer-events-auto">
			for _, it := range items {
				<li class="py-1 flex items-center justify-between gap-2">
					if it.Target != "" {
						<a
							href={ templ.SafeURL(it.Target) }
							target="_blank"
							rel="noreferrer noopener"
							class="truncate text-theme-800 dark:text-theme-200 hover:text-blue-600 dark:hover:text-blue-400"
						>{ it.Name }</a>
					} else {
						<span class="truncate text-theme-800 dark:text-theme-200">{ it.Name }</span>
					}
					if it.Label != "" {
						@ExamplePill(it.Label)
					}
				</li>
			}
		</ul>
	}
}
