package templates

templ Head(data PageData) {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		if data.Settings.Favicon != "" {
			<link rel="icon" href={ data.Settings.Favicon }/>
		}
		<title>{ data.Settings.Title }</title>
		<!-- DNS prefetch and preconnect for external CDNs -->
		<link rel="dns-prefetch" href="https://cdn.jsdelivr.net"/>
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin/>
		<link rel="dns-prefetch" href="https://cdn.simpleicons.org"/>
		<link rel="preconnect" href="https://cdn.simpleicons.org" crossorigin/>
		<link rel="dns-prefetch" href="https://unpkg.com"/>
		<link rel="preconnect" href="https://unpkg.com" crossorigin/>
		<!-- Preload critical static assets. The `?v=` is a hash of the ASSETS,
		     not of the config: config.CurrentHash() does not change when a
		     deploy ships a new stylesheet, and browsers then keep the cached
		     one for a day against the new markup. -->
		<link rel="preload" as="style" href={ staticURL(ctx, "/static/css/main.css", data.AssetVersion) }/>
		<link rel="preload" as="script" href={ staticURL(ctx, "/static/js/app.js", data.AssetVersion) }/>
		<link rel="stylesheet" href={ staticURL(ctx, "/static/css/main.css", data.AssetVersion) }/>
		<link rel="stylesheet" href={ staticURL(ctx, "/static/css/themes.css", data.AssetVersion) }/>
		<link rel="stylesheet" href={ configFileURL(ctx, "custom.css") }/>
		<!-- Early theme init to avoid FOUC. A file, not an inline script: the
		     CSP is `script-src 'self'`, which blocks inline scripts, so the
		     inline version never ran. Blocking (no defer/async) on purpose —
		     it has to apply the class before the first paint. -->
		<script src={ staticURL(ctx, "/static/js/theme-init.js", data.AssetVersion) }></script>
		<script src="https://unpkg.com/htmx.org@2.0.4"></script>
		<script src="https://unpkg.com/htmx.org@2.0.4/dist/ext/json-enc.js"></script>
		<!-- Background image (if any) is applied via a dynamic `style=""`
		     attribute on <body> in layout.templ. We cannot interpolate { ... }
		     inside <style> blocks because Templ emits them literally. -->
		<meta name="config-hash" content={ data.Hash }/>
		if basePathOf(ctx) != "" {
			<meta name="base-path" content={ basePathOf(ctx) }/>
		}
	</head>
}
