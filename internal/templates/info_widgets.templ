package templates

// SearchWidget — unified search box. Acts as both a web-search bar (Enter
// submits to the configured engine) and a live QuickLaunch: typing filters
// services and bookmarks and shows them in a dropdown right under the input.
// The drop-down behaviour is wired up by `web/static/js/app.js`
// (`#search-input` + `#search-results`).
//
// The form is a real, working GET to the configured engine, so it does the
// right thing with JavaScript off and before app.js has run. app.js reads the
// same action back instead of hardcoding an engine — see searchTarget in
// search.go.
templ SearchWidget(lang string, search SearchTarget) {
	<div class="flex-1 max-w-md">
		<form id="search-form" class="relative" action={ search.Action } method="GET" target={ search.Target } autocomplete="off">
			<input
				id="search-input"
				type="text"
				name={ search.Param }
				placeholder={ T(lang, "search.placeholder") }
				role="combobox"
				aria-autocomplete="list"
				aria-controls="search-results"
				aria-expanded="false"
				class="w-full px-4 py-2 pr-10 rounded-lg bg-theme-100 dark:bg-theme-800 border border-theme-200 dark:border-theme-700 text-sm text-theme-900 dark:text-theme-100 placeholder-theme-400 dark:placeholder-theme-500 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors"
			/>
			<button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 text-theme-400 hover:text-theme-600 dark:hover:text-theme-300" aria-label="Search">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
				</svg>
			</button>
			<div
				id="search-results"
				role="listbox"
				class="absolute w-full mt-1 bg-white dark:bg-theme-800 border border-theme-200 dark:border-theme-700 rounded-lg shadow-lg z-50 hidden max-h-80 overflow-y-auto"
			></div>
		</form>
	</div>
}

templ DatetimeWidget(lang string) {
	<div id="datetime-widget"
		 class="text-sm text-theme-600 dark:text-theme-400 font-mono"
		 data-locale={ datetimeLocale(lang) }>
		<span id="datetime-display"></span>
	</div>
}

templ GreetingWidget(lang string) {
	<div
		id="greeting-widget"
		class="text-sm font-medium text-theme-700 dark:text-theme-300"
		data-morning={ T(lang, "greeting.morning") }
		data-afternoon={ T(lang, "greeting.afternoon") }
		data-evening={ T(lang, "greeting.evening") }
		data-night={ T(lang, "greeting.night") }>
		<span id="greeting-display"></span>
	</div>
}

// ResourcesWidget renders a compact resource bar (CPU, RAM, Disk, etc).
// The initial markup is hydrated via HTMX from /api/widgets/resources which
// returns HTML (content-negotiated).
templ ResourcesWidget(opts map[string]interface{}) {
	<div class="flex items-center gap-3 px-3 py-2 bg-theme-100/50 dark:bg-theme-800/50 rounded-lg"
		hx-get={ resourcesURL(ctx, opts) }
		hx-trigger="load, every 5s"
		hx-swap="innerHTML"
		hx-target="this">
		<span class="text-[10px] text-theme-400">…</span>
	</div>
}

// ResourceBar renders a single metric as a label + percentage bar + value.
templ ResourceBar(label string, percent float64, value string, barColor string) {
	<div class="flex flex-col min-w-[80px]">
		<div class="flex items-center justify-between gap-2">
			<span class="text-[10px] uppercase text-theme-500 dark:text-theme-400 font-semibold">{ label }</span>
			<span class="text-[10px] text-theme-700 dark:text-theme-200">{ value }</span>
		</div>
		<div class="h-1 w-full bg-theme-200 dark:bg-theme-700 rounded-full overflow-hidden">
			<div class={ "h-full rounded-full", barColor } style={ barWidth(percent) }></div>
		</div>
	</div>
}

// ResourcesHTML wraps a group of ResourceBar components, used as an HTMX
// swap target.
templ ResourcesHTML(bars []ResourceBarData) {
	<div class="flex items-center gap-4">
		for _, b := range bars {
			@ResourceBar(b.Label, b.Percent, b.Value, b.BarColor)
		}
	</div>
}

// WeatherWidget renders a compact weather display. Hydrated via HTMX from
// /api/widgets/openmeteo.
templ WeatherWidget(opts map[string]interface{}) {
	<div class="flex items-center gap-2 text-theme-700 dark:text-theme-200 text-xs"
		hx-get={ weatherURL(ctx, opts) }
		hx-trigger="load, every 300s"
		hx-swap="innerHTML"
		hx-target="this">
		<svg class="w-4 h-4 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
		</svg>
	</div>
}

// WeatherHTML is the HTMX swap target for weather data.
templ WeatherHTML(label string, tempC float64, icon string) {
	<span class="inline-flex items-center gap-1">
		<span class="text-base">{ icon }</span>
		<span class="text-theme-700 dark:text-theme-200">{ label }, { FormatTemp(tempC) }</span>
	</span>
}

// QuickLaunch is kept as an empty component for source compatibility with
// older `header.templ` calls. Its functionality has been folded into
// `SearchWidget`; rendering nothing here means `settings.quicklaunch:` no
// longer produces a duplicate centred input. Remove this template once
// no caller invokes it.
templ QuickLaunch(lang string) {
}

templ ThemeToggle() {
	<button
		id="theme-toggle"
		class="p-2 rounded-lg text-theme-500 dark:text-theme-400 hover:bg-theme-100 dark:hover:bg-theme-800 transition-colors"
		title="Toggle dark/light mode">
		<svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
		</svg>
		<svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
		</svg>
	</button>
}
