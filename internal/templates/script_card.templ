package templates

import "github.com/thotenn/myserver/internal/config"

// ScriptCard renders a script service card with an execute button. The
// entire card swaps its innerHTML on execution via HTMX, replacing the
// button with a ScriptResult component.
templ ScriptCard(svc config.Service, groupName string, lang string) {
	<div class="service-card relative"
		 id={ "script-card-" + svc.Script }
		 data-script={ svc.Script }
		 data-group={ groupName }>
		@ScriptCardBody(svc, lang)
	</div>
}

// ScriptCardBody is the initial (idle) state of a script card. It is also
// rendered by the ScriptResult template as the "run again" fallback.
templ ScriptCardBody(svc config.Service, lang string) {
	<div class="flex items-center gap-2 mb-2">
		if svc.Icon != "" {
			<img src={ iconURL(svc.Icon) } alt="" class="w-8 h-8 rounded flex-shrink-0 object-contain script-icon" loading="lazy"/>
		}
		<span class="font-medium text-sm text-theme-800 dark:text-theme-200 truncate">{ svc.Name }</span>
	</div>
	if svc.Description != "" {
		<p class="text-xs text-theme-500 dark:text-theme-400 mb-3">{ svc.Description }</p>
	}
	<div class="flex gap-2 items-center">
		if svc.RequireConfirm {
			<button
				class="btn-execute flex-1"
				hx-post={ scriptRunURL(ctx, svc.Script) }
				hx-target={ "#script-card-" + svc.Script }
				hx-swap="innerHTML"
				hx-headers='{"X-Homepage-Confirm": "yes"}'
				hx-confirm={ T(lang, "scripts.confirm") + " " + svc.Name + "?" }
				hx-indicator={ "#script-spinner-" + svc.Script }>
				{ T(lang, "scripts.execute") }
			</button>
		} else {
			<button
				class="btn-execute flex-1"
				hx-post={ scriptRunURL(ctx, svc.Script) }
				hx-target={ "#script-card-" + svc.Script }
				hx-swap="innerHTML"
				hx-indicator={ "#script-spinner-" + svc.Script }>
				{ T(lang, "scripts.execute") }
			</button>
		}
		<span id={ "script-spinner-" + svc.Script } class="htmx-indicator flex items-center">
			<svg class="animate-spin h-4 w-4 text-blue-500" viewBox="0 0 24 24">
				<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/>
				<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
			</svg>
		</span>
	</div>
}

// ScriptResult renders the HTMX swap-target result after a script runs.
// It is the innerHTML replacement for the card — the outer #script-card-*
// wrapper stays in place.
templ ScriptResult(svc config.Service, status string, exitCode int, output, duration, lang string) {
	<div class="flex items-center gap-2 mb-2">
		if status == "success" {
			<svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
			</svg>
		} else if status == "error" || status == "timeout" || status == "cancelled" {
			<svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
			</svg>
		} else {
			<svg class="w-5 h-5 text-theme-400 flex-shrink-0 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<circle cx="12" cy="12" r="10" stroke-width="4"/>
			</svg>
		}
		<span class="font-medium text-sm text-theme-800 dark:text-theme-200 truncate">{ svc.Name }</span>
		<span class="text-xs text-theme-400 ml-auto">{ status } · { duration }</span>
	</div>
	if output != "" {
		<pre class="text-[10px] font-mono text-theme-700 dark:text-theme-300 bg-theme-100 dark:bg-theme-900 rounded p-2 max-h-48 overflow-y-auto whitespace-pre-wrap">{ output }</pre>
	}
	<div class="mt-3 flex gap-2 items-center">
		<button
			class="btn-execute flex-1"
			hx-post={ scriptRunURL(ctx, svc.Script) }
			hx-target={ "#script-card-" + svc.Script }
			hx-swap="innerHTML"
			if svc.RequireConfirm {
				hx-headers='{"X-Homepage-Confirm": "yes"}'
				hx-confirm={ T(lang, "scripts.confirm") + " " + svc.Name + "?" }
			}
			hx-indicator={ "#script-spinner-" + svc.Script }>
			{ T(lang, "scripts.execute") } {T(lang, "scripts.again")}
		</button>
		<span id={ "script-spinner-" + svc.Script } class="htmx-indicator flex items-center">
			<svg class="animate-spin h-4 w-4 text-blue-500" viewBox="0 0 24 24">
				<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/>
				<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
			</svg>
		</span>
	</div>
}
