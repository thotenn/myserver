package templates

import "github.com/thotenn/myserver/internal/config"

templ ServiceGroup(group config.ServiceGroup, layout *config.LayoutGroup, lang string, scriptsEnabled bool) {
	<section class="mb-6" data-group={ group.Name }>
		<h2 class="text-sm font-semibold uppercase tracking-wider text-theme-600 dark:text-theme-400 mb-3">
			{ group.Name }
		</h2>
		if layout != nil && layout.Columns > 0 {
			<div class="grid gap-3 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4" style={ gridColumns(layout.Columns) }>
				for _, svc := range group.Services {
					if svc.Type == "script" && svc.Script != "" {
						if scriptsEnabled {
							@ScriptCard(svc, group.Name, lang)
						}
					} else {
						@ServiceCard(svc, group.Name, lang)
					}
				}
			</div>
		} else {
			<div class="grid gap-3 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
				for _, svc := range group.Services {
					if svc.Type == "script" && svc.Script != "" {
						if scriptsEnabled {
							@ScriptCard(svc, group.Name, lang)
						}
					} else {
						@ServiceCard(svc, group.Name, lang)
					}
				}
			</div>
		}
	</section>
}

templ TabNavigation(tabs []TabGroup, activeTab string) {
	if len(tabs) > 1 {
		<div class="flex flex-wrap gap-2 mb-6 border-b border-theme-200 dark:border-theme-700 pb-2">
			for _, tab := range tabs {
				if tab.Name == activeTab {
					<button class="px-4 py-2 rounded-t-lg font-medium text-sm bg-theme-100 dark:bg-theme-800 text-theme-900 dark:text-theme-100 border-b-2 border-blue-500">
						{ tab.Name }
					</button>
				} else {
					<button class="px-4 py-2 rounded-t-lg font-medium text-sm text-theme-600 dark:text-theme-400 hover:text-theme-900 dark:hover:text-theme-100 hover:bg-theme-50 dark:hover:bg-theme-800 transition-colors"
						hx-get={ "/" + tab.Name }
						hx-target="#main-content"
						hx-swap="innerHTML"
						hx-push-url="true">
						{ tab.Name }
					</button>
				}
			}
		</div>
	}
}
